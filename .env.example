# Postgres
DATABASE_URL="postgresql://verifier:verifier@postgres:5432/verifier"

# Redis (BullMQ)
REDIS_URL="redis://redis:6379"

# MailTester Ninja
MTN_API_KEY="your-mtn-key"
MTN_BASE_URL="https://happy.mailtester.ninja/ninja"
# Requests allowed per RATE_WINDOW_MS. Ultimate plan = 57 per 10s.
MTN_RATE_LIMIT_MAX="57"
MTN_RATE_LIMIT_WINDOW_MS="10000"
MTN_MAX_RETRIES="3"

# No2Bounce
N2B_API_TOKEN="your-n2b-apitoken"
N2B_BASE_URL="https://connect.no2bounce.com/v2/n2b_validate_bulk"
N2B_POLL_INTERVAL_MS="15000"

# Pipeline behavior
# What the cheap pass hands on to the paid pass is fixed, not configurable:
# only what Mail Tester Ninja could not answer -- Catch-All, SPAM Block,
# Timeout, MX Error and Limited. Its "Rejected" and "No MX" are conclusive
# and settle as invalid without costing a credit.
#
# What to do with MTN "Catch-All" (code mb) results: "n2b" or "accept"
CATCH_ALL_HANDLING="n2b"
# How long each provider's verdicts may be reused, in days. 0 = never reuse.
#
# Mail Tester Ninja is flat-rate, so reusing its results saves nothing and
# only risks acting on a stale one -- people change roles and mailboxes close,
# and a months-old "Accepted" becomes a bounce. Default is to always re-verify.
MTN_CACHE_TTL_DAYS="0"
# No2Bounce costs a credit per address, so reuse is worth having.
N2B_CACHE_TTL_DAYS="90"
# Confirmed catch-all domains (established by No2Bounce, so reuse saves
# credits). Shorter than the address TTL because a domain's mail config can
# change in a way an individual mailbox result cannot.
DOMAIN_CACHE_TTL_DAYS="45"

# Alerting. Pipeline events are POSTed as JSON here -- point it at an n8n
# webhook (or anything that accepts a POST) and route from there to Slack,
# email, or wherever. Leave blank to disable.
# Events: list_failed, list_completed, provider_unavailable
ALERT_WEBHOOK_URL=""
# Used to build clickable links in those alerts.
PUBLIC_URL="https://verifier.example.com"

# Only needed if deploying with docker-compose.traefik.yml (routes through an
# existing Traefik instance instead of publishing port 3000 directly).
DOMAIN_NAME="your-domain.example.com"
VERIFIER_SUBDOMAIN="verifier"
TRAEFIK_NETWORK="root_default"
TLS_CERTRESOLVER="mytlschallenge"


# Only these email domains may hold an account (comma-separated). This gates
# the address someone types, not proof they own it -- without an email
# confirmation step, anyone reaching /signup can claim any address at an
# allowed domain.
ALLOWED_EMAIL_DOMAINS="b2bdrive.net"

# Self-healing for failures that look transient (network blips, a provider
# 5xx/429, or MTN's intermittent "Disabled Key" response) -- a list stopped
# by one of these retries itself on a backoff schedule instead of waiting
# for someone to notice and click Retry. A failure that is not retryable (a
# rejected request shape, a config problem) always goes straight to a
# person, since retrying it just produces the same failure again.
LIST_AUTO_RETRY_ENABLED="true"
# How many attempts before giving up and alerting a person.
LIST_AUTO_RETRY_MAX_ATTEMPTS="8"
# First retry delay; doubles each attempt after that.
LIST_AUTO_RETRY_BASE_DELAY_MS="60000"
# Delay never grows past this, so a long outage still gets checked
# periodically instead of the gap becoming huge.
LIST_AUTO_RETRY_MAX_DELAY_MS="1800000"
