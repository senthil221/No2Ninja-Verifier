generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ListStatus {
  pending
  running_mtn
  running_n2b
  needs_approval
  completed
  failed
}

enum RowStage {
  pending
  cache_hit
  mtn_done
  needs_n2b
  n2b_done
}

enum FinalStatus {
  valid
  invalid
  risky
  unknown
}

enum ResultSource {
  cache
  mtn
  n2b
}

enum Provider {
  mtn
  n2b
}

enum N2bBatchStatus {
  submitted
  polling
  completed
  failed
}

model Client {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  lists     List[]
}

model List {
  id             String     @id @default(cuid())
  clientId       String
  client         Client     @relation(fields: [clientId], references: [id])
  name           String
  sourceFileName String
  totalRows      Int        @default(0)
  // Original CSV header names, in original order, minus nothing -- used to
  // reconstruct the export in the same column order the user uploaded.
  columnHeaders  String[]   @default([])
  status         ListStatus @default(pending)
  // Set when the pipeline can't recover on its own (e.g. an API rejected
  // the batch) so the UI can show why instead of just a bare "failed" pill.
  lastError      String?
  createdAt      DateTime   @default(now())
  completedAt    DateTime?
  rows           ListRow[]
  n2bBatches     N2bBatch[]
  creditEntries  CreditLedger[]

  @@index([clientId])
}

model ListRow {
  id               String        @id @default(cuid())
  listId           String
  list             List          @relation(fields: [listId], references: [id], onDelete: Cascade)
  rawEmail         String
  normalizedEmail  String
  // Full original CSV row (all columns, keyed by header name) so uploaded
  // prospect data (name, company, etc.) survives the pipeline and comes
  // back on export -- not just a bare email/status pair.
  rawRow           Json          @default("{}")
  stage            RowStage      @default(pending)
  mtnStatus        String?
  mtnMessage       String?
  mtnAttempts      Int           @default(0)
  mtnCheckedAt     DateTime?
  n2bStatus        String?
  n2bCheckedAt     DateTime?
  finalStatus      FinalStatus?
  finalSource      ResultSource?
  createdAt        DateTime      @default(now())

  @@index([listId])
  @@index([normalizedEmail])
  @@index([listId, stage])
}

// Global cache keyed by email address — deliverability is a property of the
// address, not of any one client's list, so this is intentionally shared
// across all clients to maximize N2B credit savings.
model EmailCache {
  normalizedEmail  String    @id
  lastMtnResult    String?
  lastMtnCheckedAt DateTime?
  lastN2bResult    String?
  lastN2bCheckedAt DateTime?
  updatedAt        DateTime  @updatedAt
}

model N2bBatch {
  id           String         @id @default(cuid())
  listId       String
  list         List           @relation(fields: [listId], references: [id], onDelete: Cascade)
  trackingId   String
  hashkey      String?
  status       N2bBatchStatus @default(submitted)
  emailCount   Int
  resultUrl    String?
  submittedAt  DateTime       @default(now())
  completedAt  DateTime?
  lastPolledAt DateTime?
  error        String?

  @@index([listId])
  @@index([trackingId])
}

// Spend history outlives the list it came from. Deleting a list purges the
// prospect data (which is personal data, and the reason to delete at all)
// but must not rewrite what was already spent -- so listId is nullable and
// the name is snapshotted here for reporting after the list is gone.
model CreditLedger {
  id        String   @id @default(cuid())
  listId    String?
  list      List?    @relation(fields: [listId], references: [id], onDelete: SetNull)
  listName  String   @default("")
  provider  Provider
  amount    Int
  createdAt DateTime @default(now())

  @@index([listId])
}
