generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ListStatus {
  pending
  queued
  running_mtn
  running_n2b
  completed
  failed
  stopped
}

enum RowStage {
  pending
  cache_hit
  mtn_done
  needs_n2b
  n2b_done
}

enum FinalStatus {
  valid
  invalid
  risky
  unknown
}

enum ResultSource {
  cache
  mtn
  n2b
}

enum Provider {
  mtn
  n2b
}

enum N2bBatchStatus {
  submitted
  polling
  completed
  failed
}

enum UserRole {
  admin
  member
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  // scrypt, stored as salt:hash. Never the password itself.
  passwordHash String
  // The first account created is the admin; everyone after is a member.
  // Admins can see spend across all users, members only their own.
  role         UserRole  @default(member)
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?
  sessions     Session[]

  startedLists  List[]         @relation("StartedBy")
  creditEntries CreditLedger[]
}

// Sessions live in the database rather than in a signed cookie so they can
// actually be revoked -- logging out, or removing a user, ends access
// immediately instead of waiting for a token to expire.
model Session {
  token     String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
  @@index([expiresAt])
}

model Client {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  lists     List[]
}

model List {
  id             String     @id @default(cuid())
  clientId       String
  client         Client     @relation(fields: [clientId], references: [id])
  name           String
  sourceFileName String
  totalRows      Int        @default(0)
  // What the uploaded file contained before verification, so the pre-flight
  // summary can account for every line rather than silently dropping some.
  sourceRowCount Int        @default(0)
  skippedInvalid Int        @default(0)
  skippedDupes   Int        @default(0)
  // Original CSV header names, in original order, minus nothing -- used to
  // reconstruct the export in the same column order the user uploaded.
  columnHeaders  String[]   @default([])
  status         ListStatus @default(pending)
  // Set when the pipeline can't recover on its own (e.g. an API rejected
  // the batch) so the UI can show why instead of just a bare "failed" pill.
  lastError      String?
  // Whether the failure behind lastError looks transient (a network blip,
  // a provider 5xx/429) rather than something a retry cannot fix (a bad key,
  // a malformed request). Drives whether the worker retries this on its own.
  retryable      Boolean    @default(false)
  // Consecutive auto-retry attempts since the last time this list actually
  // made progress. Reset on success, capped so a genuinely broken provider
  // eventually surfaces to a person instead of retrying forever.
  autoRetryCount Int        @default(0)
  nextAutoRetryAt DateTime?
  // Who started the run, and so authorised whatever it goes on to spend.
  // Batches are submitted asynchronously by the worker, which has no
  // session, so it is recorded here at start time and read back whenever
  // spend is written for this list.
  startedById    String?
  startedBy      User?      @relation("StartedBy", fields: [startedById], references: [id], onDelete: SetNull)
  // When the user authorised this run. Approved lists wait FIFO here so one
  // list owns the complete MTN -> N2B pipeline at a time.
  queuedAt       DateTime?
  createdAt      DateTime   @default(now())
  completedAt    DateTime?
  rows           ListRow[]
  n2bBatches     N2bBatch[]
  creditEntries  CreditLedger[]

  @@index([clientId])
  @@index([status, queuedAt])
}

model ListRow {
  id               String        @id @default(cuid())
  listId           String
  list             List          @relation(fields: [listId], references: [id], onDelete: Cascade)
  rawEmail         String
  normalizedEmail  String
  // Full original CSV row (all columns, keyed by header name) so uploaded
  // prospect data (name, company, etc.) survives the pipeline and comes
  // back on export -- not just a bare email/status pair.
  rawRow           Json          @default("{}")
  stage            RowStage      @default(pending)
  mtnStatus        String?
  mtnMessage       String?
  mtnAttempts      Int           @default(0)
  mtnCheckedAt     DateTime?
  n2bStatus        String?
  n2bCheckedAt     DateTime?
  finalStatus      FinalStatus?
  finalSource      ResultSource?
  createdAt        DateTime      @default(now())

  @@index([listId])
  @@index([normalizedEmail])
  @@index([listId, stage])
}

// Global cache keyed by email address — deliverability is a property of the
// address, not of any one client's list, so this is intentionally shared
// across all clients to maximize N2B credit savings.
model EmailCache {
  normalizedEmail  String    @id
  lastMtnResult    String?
  lastMtnCheckedAt DateTime?
  lastN2bResult    String?
  lastN2bCheckedAt DateTime?
  updatedAt        DateTime  @updatedAt
}

// Some answers are properties of the domain's mail server, not of any one
// address: a domain with no MX cannot receive mail at all, and a catch-all
// domain accepts every address by definition. Establishing those once and
// reusing them is the difference between paying per address and paying per
// domain -- a list of 500 prospects across 200 companies has far fewer
// distinct domains than addresses.
model DomainCache {
  domain String @id
  // Null = not yet established. Kept separate from a plain boolean so
  // "unknown" is never mistaken for "no".
  isCatchAll Boolean?
  hasNoMx    Boolean?
  // Which provider established catch-all. No2Bounce reports it directly
  // and is treated as authoritative; Mail Tester Ninja's view is a strong
  // hint but is confirmed before it is used to skip paid checks.
  catchAllSource String?
  observations   Int      @default(0)
  updatedAt      DateTime @updatedAt
}

model N2bBatch {
  id           String         @id @default(cuid())
  listId       String
  list         List           @relation(fields: [listId], references: [id], onDelete: Cascade)
  trackingId   String
  hashkey      String?
  status       N2bBatchStatus @default(submitted)
  emailCount   Int
  resultUrl    String?
  submittedAt  DateTime       @default(now())
  completedAt  DateTime?
  lastPolledAt DateTime?
  error        String?

  @@index([listId])
  @@index([trackingId])
}

// Spend history outlives the list it came from. Deleting a list purges the
// prospect data (which is personal data, and the reason to delete at all)
// but must not rewrite what was already spent -- so listId is nullable and
// the name is snapshotted here for reporting after the list is gone.
model CreditLedger {
  id        String   @id @default(cuid())
  listId    String?
  list      List?    @relation(fields: [listId], references: [id], onDelete: SetNull)
  listName  String   @default("")
  // Nullable: entries predate attribution, and removing a user must not
  // erase the record of what was spent.
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  provider  Provider
  amount    Int
  createdAt DateTime @default(now())

  @@index([listId])
  @@index([userId])
}
